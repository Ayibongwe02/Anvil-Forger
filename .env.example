# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# Security - CHANGE IN PRODUCTION
ANVIL_SECRET_KEY=your-secret-key-here-change-in-production

# Optional: password-reset email (leave blank to show reset link in the UI instead)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=anvil@example.com
# SMTP_USE_TLS=true

# Optional: API Configuration
# API_TIMEOUT=30
# MAX_UPLOAD_SIZE=200
